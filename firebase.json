{
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "全班因數大挑戰-卡呼遊戲",
        "supportEmail": "teacher.hsieh@gmail.com",
        "authorizedRedirectUris": [
          "https://x9-factor-game.web.app/__/auth/handler"
        ]
      }
    }
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase.emulators.json",
      "**/.*",
      "**/.*/**",
      ".git/**",
      ".firebase/**",
      "**/node_modules/**",
      "**/*.rules",
      "**/*.md",
      "**/*.log",
      "**/*.example.js",
      "functions/**",
      "tests/**",
      "package.json",
      "package-lock.json",
      "firestore.indexes.json"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "v3/firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
