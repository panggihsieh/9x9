rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSuperAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email == 'teacher.hsieh@gmail.com';
    }
    function grant(email) { return get(/databases/$(database)/documents/admins/$(email)).data; }
    function roleFor(email, g) {
      return email == 'teacher.hsieh@gmail.com' ? 'admin'
        : g.role == 'auth' || (g.role == 'priorityTeacher' && g.get('priority', true)) ? 'auth' : 'guest';
    }
    function session() { return get(/databases/$(database)/documents/teacherSessions/$(request.auth.uid)).data; }
    function validSession() {
      let s = session();
      let g = grant(s.email);
      return signedIn() && s.verifiedAt + duration.value(8, 'h') > request.time
        && s.verifiedAt >= g.updatedAt && s.passcode == g.passcode
        && g.role in ['admin', 'auth', 'guest', 'priorityTeacher'] && s.role == roleFor(s.email, g);
    }
    function ownsRoom(room) {
      return validSession() && (room.get('teacherEmail', '') == session().email || session().role == 'admin');
    }
    function teacherFields(data) {
      let s = session();
      return data.teacherUid == request.auth.uid && data.teacherEmail == s.email
        && data.teacherRole == s.role && data.teacherHasPriority == (s.role != 'guest')
        && data.maxStudents == 100;
    }
    match /admins/{email} {
      allow read: if isSuperAdmin();
      allow create, update: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['email', 'role', 'passcode', 'updatedAt', 'updatedBy'])
        && request.resource.data.email == email
        && request.resource.data.passcode is string && request.resource.data.passcode.matches('^[0-9]{4}$')
        && (email == 'teacher.hsieh@gmail.com' ? request.resource.data.role == 'admin' : request.resource.data.role in ['auth', 'guest'])
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isSuperAdmin() && email != 'teacher.hsieh@gmail.com';
    }
    // Store a candidate first, then verify that immutable candidate. Repeated denied
    // session writes cannot try different PINs without consuming another attempt.
    match /teacherAttempts/{email} {
      function candidate() {
        let d = request.resource.data;
        return signedIn() && d.keys().hasOnly(['uid', 'passcode', 'attemptedAt', 'count', 'windowStartedAt'])
          && d.uid == request.auth.uid && d.passcode is string && d.passcode.matches('^[0-9]{4}$')
          && d.attemptedAt == request.time;
      }
      allow create: if candidate() && request.resource.data.count == 1 && request.resource.data.windowStartedAt == request.time;
      allow update: if candidate() && (
        (resource.data.windowStartedAt + duration.value(15, 'm') <= request.time
          && request.resource.data.count == 1 && request.resource.data.windowStartedAt == request.time)
        || (request.resource.data.windowStartedAt == resource.data.windowStartedAt
          && request.time >= resource.data.attemptedAt + duration.value(2, 's')
          && request.resource.data.count == resource.data.count + 1 && request.resource.data.count <= 5));
      allow read, delete: if false;
    }
    match /teacherSessions/{uid} {
      function verified() {
        let s = request.resource.data;
        let a = get(/databases/$(database)/documents/teacherAttempts/$(s.email)).data;
        let g = grant(s.email);
        return signedIn() && uid == request.auth.uid
          && s.keys().hasOnly(['email', 'passcode', 'role', 'verifiedAt'])
          && a.uid == uid && a.passcode == s.passcode
          && a.attemptedAt + duration.value(1, 'm') > request.time
          && g.passcode == s.passcode && g.role in ['admin', 'auth', 'guest', 'priorityTeacher']
          && s.role == roleFor(s.email, g) && s.verifiedAt == request.time;
      }
      allow create, update: if verified();
      allow get, delete: if signedIn() && uid == request.auth.uid;
      allow list: if false;
    }
    function roomOpen(room) { return room.status in ['waiting', 'active']; }
    function reclaimable(room) {
      return room.status == 'released' || (room.get('teacherEmail', '') != ''
        && room.get('teacherLastSeenAt', request.time) + duration.value(5, 'm') <= request.time
        && room.get('lastStudentSeenAt', room.updatedAt) + duration.value(5, 'm') <= request.time);
    }
    match /classrooms/{code} {
      function archived() {
        let oldId = resource.data.get('sessionId', 'legacy');
        return getAfter(/databases/$(database)/documents/classrooms/$(code)/sessions/$(oldId)).data == resource.data;
      }
      function freshRoom() {
        let d = request.resource.data;
        return teacherFields(d) && d.status == 'waiting' && d.studentCount == 0
          && d.code == code && d.sessionId is string && d.sessionId.size() > 0
          && d.teacherLastSeenAt == request.time && d.lastStudentSeenAt == request.time
          && d.createdAt == request.time && d.updatedAt == request.time;
      }
      function release() {
        return (isSuperAdmin() || ownsRoom(resource.data) || (roomOpen(resource.data) && reclaimable(resource.data)))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'releasedAt', 'updatedAt'])
          && request.resource.data.status == 'released' && request.resource.data.releasedAt == request.time
          && request.resource.data.updatedAt == request.time;
      }
      function maintain() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return roomOpen(resource.data) && ownsRoom(resource.data)
          && request.resource.data.teacherUid == request.auth.uid
          && changed.hasOnly(['teacherUid', 'teacherLastSeenAt', 'updatedAt', 'status', 'startedAt'])
          && request.resource.data.status in ['waiting', 'active']
          && (!changed.hasAny(['teacherLastSeenAt']) || request.resource.data.teacherLastSeenAt == request.time)
          && request.resource.data.updatedAt == request.time;
      }
      function studentHeartbeat() {
        let d = request.resource.data;
        let changed = d.diff(resource.data).affectedKeys();
        let student = getAfter(/databases/$(database)/documents/classrooms/$(code)/students/$(d.studentHeartbeatId)).data;
        return roomOpen(resource.data) && changed.hasOnly(['studentCount', 'updatedAt', 'lastStudentSeenAt', 'studentHeartbeatId'])
          && d.lastStudentSeenAt == request.time && student.lastSeen == request.time
          && student.sessionId == resource.data.sessionId
          && (d.studentCount == resource.data.studentCount || d.studentCount == resource.data.studentCount + 1)
          && d.studentCount <= resource.data.maxStudents;
      }
      allow read: if true;
      allow create: if validSession() && freshRoom();
      allow update: if release() || maintain()
        || (validSession() && reclaimable(resource.data) && freshRoom()
          && request.resource.data.sessionId != resource.data.get('sessionId', '') && archived())
        || studentHeartbeat();
      // Releasing preserves previous sessions and answers instead of deleting data.
      allow delete: if false;
      match /sessions/{sessionId} {
        allow read: if true;
        allow create: if validSession()
          && sessionId == get(/databases/$(database)/documents/classrooms/$(code)).data.get('sessionId', 'legacy')
          && request.resource.data == get(/databases/$(database)/documents/classrooms/$(code)).data
          && reclaimable(request.resource.data);
        allow update, delete: if false;
      }
      match /students/{studentId} {
        function currentStudent() {
          let room = get(/databases/$(database)/documents/classrooms/$(code)).data;
          return roomOpen(room) && request.resource.data.sessionId == room.sessionId
            && request.resource.data.lastSeen == request.time;
        }
        allow read: if true;
        allow create: if currentStudent() && request.resource.data.keys().hasOnly([
          'name', 'sessionId', 'score', 'joinedAt', 'lastSeen', 'onlineAt', 'status', 'tasks', 'currentNumber'
        ]);
        allow update: if currentStudent() && resource.data.sessionId == request.resource.data.sessionId;
        allow delete: if false;
      }
    }
  }
}
