rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSuperAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email == 'teacher.hsieh@gmail.com';
    }
    function teacherAuthorized() {
      let session = get(/databases/$(database)/documents/teacherAuthorizationSessions/$(request.auth.uid)).data;
      let code = get(/databases/$(database)/documents/teacherAuthorizationCodes/$(session.code)).data;
      return code.enabled == true && session.authorizedAt >= code.updatedAt
        && session.authorizedAt + duration.value(1, 'h') > request.time;
    }
    match /teacherAuthorizationCodes/{code} {
      allow read: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && code.matches('^[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['label', 'enabled', 'updatedAt'])
        && request.resource.data.label is string && request.resource.data.label.size() <= 80
        && request.resource.data.enabled is bool && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /teacherAuthorizationAttempts/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'attemptedAt'])
        && request.resource.data.code.matches('^[0-9]{4}$')
        && request.resource.data.attemptedAt == request.time
        && (resource == null || resource.data.attemptedAt + duration.value(5, 's') <= request.time);
      allow delete: if false;
    }
    match /teacherAuthorizationSessions/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      function validAuthorization() {
        let d = request.resource.data;
        let attempt = get(/databases/$(database)/documents/teacherAuthorizationAttempts/$(uid)).data;
        let code = get(/databases/$(database)/documents/teacherAuthorizationCodes/$(d.code)).data;
        return d.keys().hasOnly(['code', 'authorizedAt']) && d.code.matches('^[0-9]{4}$')
          && d.authorizedAt == request.time && code.enabled == true
          && attempt.code == d.code && attempt.attemptedAt + duration.value(30, 's') > request.time;
      }
      allow create, update: if signedIn() && request.auth.uid == uid
        && (request.resource.data == {'revoked': true} || validAuthorization());
      allow delete: if false;
    }
    function ownsRoom(room) {
      return signedIn() && (room.teacherUid == request.auth.uid || isSuperAdmin());
    }
    function teacherFields(data) {
      return signedIn() && teacherAuthorized() && data.teacherUid == request.auth.uid
        && data.teacherEmail == request.auth.uid + '@guest.invalid'
        && data.teacherRole == 'guest' && data.teacherHasPriority == false
        && data.maxStudents == 100;
    }
    // Retired credential collections have no client access; existing data is retained.
    function roomOpen(room) { return room.status in ['waiting', 'active']; }
    function presenceExpired(room) {
      let path = /databases/$(database)/documents/roomPresence/$(room.get('sessionId', 'legacy'));
      return !exists(path) || (get(path).data.get('teacherLastSeenAt', room.updatedAt) + duration.value(5, 'm') <= request.time
        && get(path).data.get('lastStudentSeenAt', room.updatedAt) + duration.value(5, 'm') <= request.time);
    }
    function reclaimable(room) {
      return room.status == 'released' || (room.get('teacherEmail', '') != ''
        && room.get('teacherLastSeenAt', request.time) + duration.value(5, 'm') <= request.time
        && room.get('lastStudentSeenAt', room.updatedAt) + duration.value(5, 'm') <= request.time
        && presenceExpired(room));
    }
    match /roomPresence/{sessionId} {
      allow read: if true;
      function validPresence() {
        let d = request.resource.data;
        let room = get(/databases/$(database)/documents/classrooms/$(d.code)).data;
        let changed = d.diff(resource == null ? {} : resource.data).affectedKeys();
        return d.sessionId == sessionId && room.sessionId == sessionId && roomOpen(room)
          && d.keys().hasOnly(['code', 'sessionId', 'teacherLastSeenAt', 'lastStudentSeenAt', 'studentHeartbeatId'])
          && (resource == null || (resource.data.code == d.code && resource.data.sessionId == d.sessionId))
          && ((ownsRoom(room) && changed.hasOnly(['code', 'sessionId', 'teacherLastSeenAt']) && d.teacherLastSeenAt == request.time)
            || (changed.hasOnly(['code', 'sessionId', 'lastStudentSeenAt', 'studentHeartbeatId'])
              && d.lastStudentSeenAt == request.time
              && getAfter(/databases/$(database)/documents/classrooms/$(d.code)/students/$(d.studentHeartbeatId)).data.lastSeen == request.time
              && getAfter(/databases/$(database)/documents/classrooms/$(d.code)/students/$(d.studentHeartbeatId)).data.sessionId == sessionId));
      }
      allow create, update: if validPresence();
      allow delete: if false;
    }
    match /classrooms/{code} {
      function archived() {
        let oldId = resource.data.get('sessionId', 'legacy');
        return getAfter(/databases/$(database)/documents/classrooms/$(code)/sessions/$(oldId)).data == resource.data;
      }
      function freshRoom() {
        let d = request.resource.data;
        return teacherFields(d) && d.status == 'waiting' && d.studentCount == 0
          && d.get('difficulty', 'beginner') in ['beginner', 'intermediate', 'advanced']
          && d.code == code && d.sessionId is string && d.sessionId.size() > 0
          && d.teacherLastSeenAt == request.time && d.lastStudentSeenAt == request.time
          && d.createdAt == request.time && d.updatedAt == request.time;
      }
      function release() {
        return (isSuperAdmin() || ownsRoom(resource.data) || (roomOpen(resource.data) && reclaimable(resource.data)))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'releasedAt', 'updatedAt'])
          && request.resource.data.status == 'released' && request.resource.data.releasedAt == request.time
          && request.resource.data.updatedAt == request.time;
      }
      function maintain() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return roomOpen(resource.data) && ownsRoom(resource.data) && teacherAuthorized()
          && request.resource.data.teacherUid == request.auth.uid
          && changed.hasOnly(['teacherUid', 'teacherLastSeenAt', 'updatedAt', 'status', 'startedAt', 'durationMinutes'])
          && (!changed.hasAny(['durationMinutes']) || request.resource.data.durationMinutes in [2, 3, 5, 10])
          && request.resource.data.status in ['waiting', 'active']
          && (!changed.hasAny(['teacherLastSeenAt']) || request.resource.data.teacherLastSeenAt == request.time)
          && request.resource.data.updatedAt == request.time;
      }
      function studentHeartbeat() {
        let d = request.resource.data;
        let changed = d.diff(resource.data).affectedKeys();
        let student = getAfter(/databases/$(database)/documents/classrooms/$(code)/students/$(d.studentHeartbeatId)).data;
        return roomOpen(resource.data) && changed.hasOnly(['studentCount', 'updatedAt', 'lastStudentSeenAt', 'studentHeartbeatId'])
          && d.lastStudentSeenAt == request.time && student.lastSeen == request.time
          && student.sessionId == resource.data.sessionId
          && (d.studentCount == resource.data.studentCount || d.studentCount == resource.data.studentCount + 1)
          && d.studentCount <= resource.data.maxStudents;
      }
      allow read: if true;
      allow create: if signedIn() && freshRoom();
      allow update: if release() || maintain()
        || (signedIn() && reclaimable(resource.data) && freshRoom()
          && request.resource.data.sessionId != resource.data.get('sessionId', '') && archived())
        || studentHeartbeat();
      // Releasing preserves previous sessions and answers instead of deleting data.
      allow delete: if false;
      match /sessions/{sessionId} {
        allow read: if true;
        allow create: if signedIn()
          && sessionId == get(/databases/$(database)/documents/classrooms/$(code)).data.get('sessionId', 'legacy')
          && request.resource.data == get(/databases/$(database)/documents/classrooms/$(code)).data
          && reclaimable(request.resource.data);
        allow update, delete: if false;
      }
      match /students/{studentId} {
        function taskPoints(task, points) {
          let before = resource.data;
          let after = request.resource.data;
          let oldTasks = before.get('tasks', {});
          let newTasks = after.get('tasks', {});
          return oldTasks.get(task, false) == false && newTasks.get(task, false) == true
            && newTasks.diff(oldTasks).affectedKeys().hasOnly([task])
            && after.score == before.score + points
            && (after.get('passCounts', {}) == before.get('passCounts', {})
              || (points > 0 && after.get('passCounts', {}).diff(before.get('passCounts', {})).affectedKeys().hasOnly([task])
                && after.get('passCounts', {}).get(task, 0) == before.get('passCounts', {}).get(task, 0) + 1));
        }
        function batchTask(task) {
          let b = resource.data;
          let a = request.resource.data;
          let wasDone = b.get('tasks', {}).get(task, false);
          let done = a.get('tasks', {}).get(task, false);
          let wrong = a.get('wrongAttempts', {}).get(task, 0);
          let revealed = a.get('revealedTasks', {}).get(task, false);
          let earned = !wasDone && done && !revealed;
          return done is bool && revealed is bool && wrong is int
            && wrong >= b.get('wrongAttempts', {}).get(task, 0) && wrong <= 5
            && (!wasDone || (done && revealed == b.get('revealedTasks', {}).get(task, false)
              && wrong == b.get('wrongAttempts', {}).get(task, 0)))
            && (!revealed || (done && wrong == 5))
            && (done || wrong < 5)
            && (!earned || wrong < 5)
            && a.get('passCounts', {}).get(task, 0) == b.get('passCounts', {}).get(task, 0) + (earned ? 1 : 0);
        }
        function batchPoints(task, points) {
          return !resource.data.get('tasks', {}).get(task, false)
            && request.resource.data.get('tasks', {}).get(task, false)
            && !request.resource.data.get('revealedTasks', {}).get(task, false) ? points : 0;
        }
        function batchedScore() {
          let a = request.resource.data;
          return a.get('roundVersion', 0) == resource.data.get('roundVersion', 0)
            && a.currentNumber == resource.data.currentNumber
            && a.diff(resource.data).affectedKeys().hasOnly(['score', 'tasks', 'passCounts', 'wrongAttempts', 'revealedTasks', 'onlineAt', 'lastSeen'])
            && batchTask('factors') && batchTask('pairs') && batchTask('primes')
            && a.score == resource.data.score + batchPoints('factors', 14) + batchPoints('pairs', 18) + batchPoints('primes', 14);
        }
        function validScoring() {
          let before = resource.data;
          let after = request.resource.data;
          let sameRound = after.get('roundVersion', 0) == before.get('roundVersion', 0)
            && after.get('currentNumber', 24) == before.get('currentNumber', 24);
          let unchanged = after.get('score', 0) == before.get('score', 0)
            && after.get('tasks', {}) == before.get('tasks', {})
            && after.get('passCounts', {}) == before.get('passCounts', {});
          let nextRound = after.get('roundVersion', 0) == before.get('roundVersion', 0) + 1
            && after.score == before.score
            && after.get('passCounts', {}) == before.get('passCounts', {})
            && after.currentNumber is int && after.currentNumber >= 2 && after.currentNumber <= 100
            && after.tasks == {'factors': false, 'pairs': false, 'primes': false};
          return (sameRound && (unchanged || taskPoints('factors', 14)
            || taskPoints('pairs', 18) || taskPoints('primes', 14)
            || revealedTask('factors') || revealedTask('pairs') || revealedTask('primes'))) || nextRound;
        }
        function revealedTask(task) {
          return taskPoints(task, 0)
            && request.resource.data.get('revealedTasks', {}).get(task, false) == true
            && request.resource.data.get('wrongAttempts', {}).get(task, 0) == 5
            && resource.data.get('wrongAttempts', {}).get(task, 0) == 4;
        }
        function currentStudent() {
          let room = get(/databases/$(database)/documents/classrooms/$(code)).data;
          return roomOpen(room) && request.resource.data.sessionId == room.sessionId
            && request.resource.data.lastSeen == request.time;
        }
        allow read: if true;
        allow create: if currentStudent() && request.resource.data.score == 0
          && request.resource.data.tasks == {'factors': false, 'pairs': false, 'primes': false}
          && request.resource.data.keys().hasOnly([
          'name', 'sessionId', 'score', 'joinedAt', 'lastSeen', 'onlineAt', 'status', 'tasks', 'currentNumber'
        ]);
        allow update: if currentStudent() && resource.data.sessionId == request.resource.data.sessionId
          && (validScoring() || batchedScore());
        allow delete: if false;
      }
    }
  }
}
